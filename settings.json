{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787"
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__codegraph_explore",
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_files",
      "mcp__codegraph__codegraph_status"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"Run /experience to log session diagnostics to agent memory\"}'",
            "statusMessage": "Agent memory reminder"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/headroom init hook ensure --profile init-user --marker headroom-init-claude",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\":\"Before answering the first substantive user request in this session, invoke /skill-radar. It must search local skills first, then available plugins/catalogs, ask only when a plausible match exists, and never invoke or install a candidate without explicit approval.\"}'",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "~/.local/bin/headroom init hook ensure --profile init-user --marker headroom-init-claude",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gitkraken-hooks@gitkraken": true,
    "gopls-lsp@claude-plugins-official": true,
    "headroom@headroom-marketplace": true,
    "resyndeo@resyndeo": true,
    "superpowers@claude-plugins-official": true,
    "vercel-plugin@vercel": false,
    "ponytail@ponytail": true,
    "playwright@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "desquirrel@desquirrel-local": true
  },
  "extraKnownMarketplaces": {
    "gitkraken": {
      "source": {
        "source": "directory",
        "path": "~/.claude/plugins/marketplaces/gitkraken"
      }
    },
    "headroom-marketplace": {
      "source": {
        "source": "github",
        "repo": "chopratejas/headroom"
      }
    },
    "resyndeo": {
      "source": {
        "source": "github",
        "repo": "Syndeo-AI/resyndeo-claude-plugin"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "desquirrel-local": {
      "source": {
        "source": "directory",
        "path": "/Users/devinat1/plugins/desquirrel"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
