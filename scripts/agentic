#!/usr/bin/env python3
"""Inspect the shared agent home or resolve an indexed resource."""
import argparse
import importlib.util
import json
import os
from pathlib import Path

parser = argparse.ArgumentParser(description=__doc__)
commands = parser.add_subparsers(dest='command', required=True)
commands.add_parser('doctor')
upkeep = commands.add_parser('upkeep')
upkeep.add_argument('--apply', action='store_true', help='Adopt skills and repair discovery links; default is dry-run')
upkeep.add_argument('--dry-run', action='store_true', help='Report pending adoption without writes')
lookup = commands.add_parser('path')
lookup.add_argument('name')
args = parser.parse_args()
root = Path(os.environ.get('AGENTIC_HOME', Path.home() / '.agentic')).expanduser()
if args.command == 'upkeep':
    if args.apply and args.dry_run:
        parser.error('Choose --apply or --dry-run')
    spec = importlib.util.spec_from_file_location('catalog', Path(__file__).resolve().with_name('skill-catalog.py'))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    print(json.dumps(module.run(Path.home(), root, apply=args.apply), indent=2))
elif args.command == 'doctor':
    spec = importlib.util.spec_from_file_location('migration', Path(__file__).resolve().with_name('migrate-agentic-home.py'))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    module.verify(Path.home(), root)
else:
    index = json.loads((root / 'index.json').read_text())
    if args.name in index['external_resources']:
        print(index['external_resources'][args.name])
    elif args.name in index['paths']:
        print(root / index['paths'][args.name])
    elif args.name in index['repositories']:
        print(root / index['repositories'][args.name]['path'])
    else:
        parser.error('Unknown indexed resource: ' + args.name)
